# Copy to .env.local for local dev. Add the same keys in Vercel → Project → Settings → Environment Variables.

# Canonical URL used for SEO, sitemap and social cards (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://admiredevportfolio.vercel.app

# Optional — enables the contact form to send email via https://resend.com
# Without these, the form falls back to opening the visitor's email app.
RESEND_API_KEY=
CONTACT_TO_EMAIL=ndanetaadmire@gmail.com
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
